# Supabase — Variables de entorno del frontend (QuantBattle web)
# Copia este archivo a `.env.local` y completa los valores reales.
# El orquestador provee los valores definitivos de NEXT_PUBLIC_*.
#
# Nunca commitees .env.local (ya está ignorado en .gitignore).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Worker de backtest
# Producción: https://quantlab2.onrender.com
# Local: http://localhost:8001
NEXT_PUBLIC_WORKER_URL=https://quantlab2.onrender.com

# Stripe — Pagos para compra de QP
# Secret key del Dashboard de Stripe (comienza con sk_test_ o sk_live_)
# Dejar vacío para desarrollo sin Stripe
STRIPE_SECRET_KEY=

# Secret del webhook (comienza con whsec_) — se configura en el Dashboard de Stripe
STRIPE_WEBHOOK_SECRET=

# Clave interna que el webhook comparte con el worker para los endpoints
# /internal/tokens/* — server-side only (nunca exponer en el cliente ni commitear)
SCHEDULER_KEY=

# IDs opcionales de precios pre-creados en Stripe Dashboard
# Si se usan, las line_items del checkout referencian estos IDs en vez de price_data
STRIPE_PRICE_PLUS_ID=
STRIPE_PRICE_PRO_ID=
STRIPE_PRICE_LEGEND_ID=

# URL base del sitio (para success_url y cancel_url en Stripe)
# URL canónica del proyecto. En local usar http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://www.quantbattle.co
ENABLE_BILLING=false
NEXT_PUBLIC_ENABLE_BILLING=false
